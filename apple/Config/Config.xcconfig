// Build settings shared by the app and test targets. App.xcconfig and Tests.xcconfig
// include this file. Signing stays out of shared config and the project: copy
// Local.xcconfig.example to Local.xcconfig (ignored by Git) for your team and, if
// needed, bundle ID.

APP_BUNDLE_IDENTIFIER = com.ajustinjames.purpleradio

// Twitch application client ID (#19). Not a secret for a public client; commit it
// here once the app is registered. Read at runtime through Info.plist.
TWITCH_CLIENT_ID =

SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
WATCHOS_DEPLOYMENT_TARGET = 27.0

SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = NO
CODE_SIGN_STYLE = Automatic
